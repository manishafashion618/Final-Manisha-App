# ─────────────────────────────────────────────────────────────
# Manisha Fashions — Backend environment
# PRD 8.5 / 8.11: this file is a TEMPLATE. Copy to .env and fill in.
# .env itself is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ── Database (PRD 8.2 — MongoDB Atlas) ──
# Safety guards (config/dbTarget.ts): tests refuse to run against anything but a
# local/in-memory MongoDB, and scripts that write data (seed, seed:demo,
# make-admin, smoke, audit, coverage, dev:memory) refuse any non-local database
# unless run with --target=production, e.g.  npm run seed -- --target=production
MONGODB_URI=mongodb://127.0.0.1:27017/manisha_fashions


# ── JWT (PRD 8.7) ──
# Must be long random values, different from each other. In production the
# server refuses to boot on anything under 32 characters, on the placeholders
# below, or on other known weak values. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotate immediately if ever exposed (every session is signed out).
JWT_ACCESS_SECRET=change-me-to-a-64-char-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-64-char-random-string
JWT_ACCESS_TTL=30m
# Default idle period before OTP is required again (PRD 4.1) — admin-configurable.
JWT_REFRESH_TTL_DAYS=90

# ── Cloudinary (PRD 8.3) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=manisha-fashions/products

# ── Razorpay (PRD 4.4) ──
# Test vs live is decided ONLY here: rzp_test_… keys for testing, rzp_live_…
# for real money. Nothing is hardcoded; the app gets the key id from GET
# /config. The key id and secret must come from the same mode, and the webhook
# secret from the webhook created in that same mode's dashboard. At boot the
# server logs a clear error if any of these are missing or mismatched.
# Webhook URL to register in the dashboard:
#   https://<your-api-host>/api/v1/webhooks/razorpay
# with events: payment.captured, payment.failed, refund.processed, refund.failed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# An unpaid online order is cancelled, and its stock released, after this long.
PENDING_PAYMENT_TTL_MINUTES=30
ORDER_EXPIRY_SWEEP_MINUTES=5

# ── Commerce settings (PRD 6 — open items, admin-tunable) ──
# Cash on Delivery is configured PER STATE from the admin app
# (Account → Store management → COD settings), which writes to the
# `codstateconfigs` collection. These two values are the fallback for any
# state that has no row yet, so COD works on a fresh database.
#
# COD shipping charge in paise (5000 = ₹50.00). Confirm amount with client.
COD_SHIPPING_CHARGE=5000
# Set to false to make COD opt-in: off everywhere except the states admin enables.
COD_DEFAULT_ENABLED=true
PREPAID_SHIPPING_CHARGE=0
CURRENCY=INR

# ── Security (PRD 8.11) ──
# Browser origins allowed to call the API (comma-separated). The mobile app
# sends no Origin and is always allowed. In PRODUCTION an empty value denies
# every browser origin; list an origin only if a web front end needs the API.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
RATE_LIMIT_GENERAL_PER_MIN=100
TRUST_PROXY=1

# ── Google Sign-In ──
# The WEB OAuth client id from Google Cloud Console (APIs & Services →
# Credentials), e.g. 1234-abc.apps.googleusercontent.com. Not a secret, but
# environment-specific. The Android app is configured with this SAME id
# (app.json → extra.googleWebClientId), so it is the audience of every token
# the app sends. The Android OAuth client must also exist, but its id is not
# used here. Required in production — the server refuses to boot without it.
GOOGLE_WEB_CLIENT_ID=

# ── Transactional email ──
# Brevo's HTTPS API. When set, all mail goes through it and the SMTP settings
# below are not used. Production needs this: Render's free tier blocks
# outbound SMTP. Create a key at Brevo → SMTP & API → API keys; the sender
# (manishafashion618@gmail.com) must be a verified sender there.
BREVO_API_KEY=

# Gmail SMTP — the fallback when BREVO_API_KEY is blank. In production, either
# BREVO_API_KEY or both SMTP settings are required; the server refuses to boot
# with neither.
# Leave them blank in development: the reset code is logged to the server
# console instead of being emailed.
#
# SMTP_APP_PASSWORD is a Gmail *App Password*, not the account login password.
# Generate at: Google Account → Security → 2-Step Verification → App Passwords
# (2-Step Verification must be on). Gmail shows it as four groups of four;
# spaces are stripped automatically, so either form works.
#
# ⚠️ An App Password grants access to the whole Google Account. Keep it out of
# git (this file's real counterpart, .env, is gitignored) and revoke it at the
# link above if it is ever pasted somewhere it shouldn't be.
SMTP_USER=
SMTP_APP_PASSWORD=

# ── Password reset ──
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=5
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_LOCKOUT_MINUTES=10
# Per email AND per IP, enforced in the service (not the IP rate limiter).
FORGOT_PASSWORD_MAX_PER_HOUR=3

# ── Error reporting (Sentry) ──
# Optional. Unset = off. Events carry no request bodies, cookies or headers,
# and emails, phones, tokens and 6-digit codes are scrubbed from all text.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── Admin access ──
# Comma-separated whitelist. Re-evaluated on EVERY sign-in, so adding or
# removing an address takes effect on that account's next login — including
# demotion. Treat as a credential: anyone who can sign in as a listed
# address gets full admin.
ADMIN_EMAILS=

# ── Seed / bootstrap admin ──
# Used only by `npm run seed`, which refuses to run without a password (there
# is no default). Change the password after the first login, and verify the
# address in the app (Profile → Verify email): admin needs it on ADMIN_EMAILS
# AND verified.
SEED_ADMIN_EMAIL=admin@manishafashions.in
SEED_ADMIN_PASSWORD=
